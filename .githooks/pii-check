#!/bin/bash
# Block commits/pushes that contain real family data (kids' names, school, district).
#
# This repo is public. The patterns live OUTSIDE the repo, in a denylist file, because
# committing the list would publish exactly what it protects. One case-insensitive
# extended regex per line; blank lines and lines starting with # are ignored.
#
# Usage (called from .githooks/*):
#   pii-check staged          added lines + paths in the index      (pre-commit)
#   pii-check msg <file>      a commit message file                 (commit-msg)
#   pii-check push            commits read from pre-push stdin      (pre-push)
set -euo pipefail

DENYLIST="${VULCAN_PII_DENYLIST:-$HOME/.config/vulcan-notify/pii-denylist}"
ZERO=0000000000000000000000000000000000000000

if [ ! -s "$DENYLIST" ]; then
    echo "pii-check: denylist missing or empty: $DENYLIST" >&2
    echo "  Create it with one regex per line (kids' names, nicknames, surname, school, district)." >&2
    echo "  This repo is public; the hook fails closed until the denylist exists." >&2
    exit 1
fi

PATTERNS=$(grep -v -E '^[[:space:]]*(#|$)' "$DENYLIST")
export LC_ALL=en_US.UTF-8

# scan <label>: reads text on stdin, prints matching lines, returns 1 on any match.
scan() {
    local hits
    hits=$(grep -n -i -E -f <(printf '%s\n' "$PATTERNS") || true)
    if [ -n "$hits" ]; then
        echo "pii-check: real family data found in $1:" >&2
        printf '%s\n' "$hits" | head -20 | sed 's/^/    /' >&2
        return 1
    fi
}

fail() {
    echo "" >&2
    echo "Blocked. Use fixture names instead (Helena/Hela Nowak, Marcel Nowak, testdistrict)." >&2
    echo "Patterns: $DENYLIST" >&2
    exit 1
}

scan_range() {
    local range=("$@") rc=0
    git log --format='%B' "${range[@]}" | scan "commit messages" || rc=1
    git log --name-only --format= "${range[@]}" | scan "file paths" || rc=1
    git log -p --no-color --format= "${range[@]}" | grep -E '^\+' | grep -v -E '^\+\+\+ ' |
        scan "added lines" || rc=1
    return $rc
}

case "${1:-}" in
    staged)
        rc=0
        git diff --cached --name-only --diff-filter=ACMR | scan "staged file paths" || rc=1
        git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -v -E '^\+\+\+ ' |
            scan "staged changes" || rc=1
        [ $rc -eq 0 ] || fail
        ;;
    msg)
        grep -v '^#' "$2" | scan "the commit message" || fail
        ;;
    push)
        rc=0
        while read -r _local_ref local_sha _remote_ref remote_sha; do
            [ "$local_sha" = "$ZERO" ] && continue
            if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
                scan_range "$remote_sha..$local_sha" || rc=1
            else
                scan_range "$local_sha" --not --remotes || rc=1
            fi
        done
        [ $rc -eq 0 ] || fail
        ;;
    *)
        echo "usage: pii-check staged | msg <file> | push" >&2
        exit 2
        ;;
esac
